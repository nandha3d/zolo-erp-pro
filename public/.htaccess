<IfModule mod_rewrite.c>
    <IfModule mod_negotiation.c>
        Options -MultiViews -Indexes
    </IfModule>

    RewriteEngine On

    # Handle Authorization Header
    RewriteCond %{HTTP:Authorization} .
    RewriteRule .* - [E=HTTP_AUTHORIZATION:%{HTTP:Authorization}]

    # Redirect Trailing Slashes If Not A Folder...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_URI} (.+)/$
    RewriteRule ^ %1 [L,R=301]

    # Company attachments are served by DocumentFileController after an ownership check, never directly.
    RewriteRule ^documents/(sale|purchase|sale_return|purchase_return|quotation|expense|delivery|transfer|adjustment|add-payment|notification|production)(/|$) - [F,L,NC]
    RewriteRule ^images/(employee|sale_agent|supplier)(/|$) - [F,L,NC]

    # Send Requests To Front Controller...
    RewriteCond %{REQUEST_FILENAME} !-d
    RewriteCond %{REQUEST_FILENAME} !-f
    RewriteRule ^ index.php [L]
</IfModule>

# Revalidate public code and fonts instead of downloading them on every page switch.
<IfModule mod_headers.c>
    <IfModule mod_setenvif.c>
        SetEnvIf Request_URI "^/(css|js|vendor|fonts)/.*\.(css|js|woff2?|ttf|eot)$" zolo_static_asset
        Header set Cache-Control "public, max-age=0, must-revalidate" env=zolo_static_asset
        # Versioned code URLs are refreshed by the layout whenever their source file changes.
        SetEnvIfExpr "%{REQUEST_URI} =~ m#^/(css|js|vendor|fonts)/.*\.(css|js|woff2?|ttf|eot)$# && %{QUERY_STRING} =~ m#^v=[0-9]+-[0-9]+$#" zolo_versioned_asset
        Header set Cache-Control "public, max-age=31536000, immutable" env=zolo_versioned_asset
    </IfModule>
</IfModule>
